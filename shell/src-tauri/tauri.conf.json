{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noobty",
  "version": "0.2.0",
  "identifier": "app.noobty.shell",
  "build": {
    "frontendDist": "../shell-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QTJCMEU5OEM2OTE3QjQKUldTMEYybU02YkNpNTRKYnlXdGIwUmduRjU1NGhPSExSNWVXb21iTXJxV3RIeThCMi9iRmZlRHYK",
      "endpoints": ["http://127.0.0.1:7317/releases/shell/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
