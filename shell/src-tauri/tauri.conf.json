{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noobty",
  "version": "0.1.0",
  "identifier": "app.noobty.shell",
  "build": {
    "frontendDist": "../shell-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
